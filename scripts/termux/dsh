#!/data/data/com.termux/files/usr/bin/bash
# dsh launcher for Termux source build.
# - CI=true: skip lefthook postinstall checks
# - --expose-internals: cordis loader needs Node internal ESM loader
#   (node-addon-require-builtin has no android prebuilt)
# Runs from the caller's cwd so session project context is preserved.
export CI=true
# The checkout this launcher runs from; override when yours lives elsewhere.
DSH_REPO="${DSH_REPO:-$HOME/build/deepseek-harness}"
exec node --expose-internals \
  --import "$DSH_REPO/node_modules/tsx/dist/esm/index.mjs" \
  "$DSH_REPO/apps/cli/src/bin.ts" "$@"
